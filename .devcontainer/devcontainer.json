{
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": {
    "cpus": 4
  },
  "waitFor": "onCreateCommand",
  "updateContentCommand": "npm install && cd backend && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
  "postCreateCommand": "",
  "postAttachCommand": {
    "server": "npm start",
    "api": "npm run api:mock"
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  },
  "portsAttributes": {
    "3000": {
      "label": "Application",
      "onAutoForward": "openPreview"
    },
    "8000": {
      "label": "API"
    }
  },
  "forwardPorts": [3000, 8000]
}
