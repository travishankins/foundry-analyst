# Azure AI Foundry project endpoint: https://<resource>.services.ai.azure.com/api/projects/<project>
PROJECT_ENDPOINT=
MODEL_DEPLOYMENT_NAME=gpt-5.4
# Orchestrator model. It owns the Learn MCP tool, which the classic Agents API does not run on gpt-5.x, so keep this on gpt-4.1
ORCHESTRATOR_MODEL_DEPLOYMENT_NAME=gpt-4.1
# Full resource ID of the Microsoft Fabric connection in the Foundry project
FABRIC_CONNECTION_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<resource>/projects/<project>/connections/<fabric-connection>
MCP_SERVER_URL=https://learn.microsoft.com/api/mcp
MCP_SERVER_LABEL=microsoft_learn
ALLOWED_ORIGINS=http://localhost:3000
# Set to 1 to run the UI against scripted responses without Azure
MOCK_AGENTS=0

# Sharing (Share button). Leave SHARE_MODE empty: it follows MOCK_AGENTS (mock = simulated delivery, nothing is sent).
# Set SHARE_MODE=graph for real delivery; a channel appears in the UI only when its settings below are filled in.
SHARE_MODE=
# Teams: an incoming-webhook / Workflows URL for the target channel
TEAMS_WEBHOOK_URL=
# Email: mailbox the app sends as (needs Graph Mail.Send for the app identity)
SHARE_EMAIL_SENDER=
# Optional comma-separated allow-list of recipient domains, e.g. contoso.com
SHARE_ALLOWED_EMAIL_DOMAINS=
# SharePoint: document-library drive ID and folder (needs Graph Files.ReadWrite.All / Sites.Selected)
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER=Foundry Analyst
# OneDrive: UPN whose OneDrive receives the file
ONEDRIVE_USER=

# Sign-in and roles. Leave AUTH_MODE empty: it follows MOCK_AGENTS (mock = pick a demo persona, NOT secure).
# For real use set ENTRA_TENANT_ID and ENTRA_CLIENT_ID (see README "Sign-in and roles").
AUTH_MODE=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Persist the library, approvals, incidents and audit log across restarts (relative to backend/). Empty = memory only.
DATA_DIR=data

# Approvals and events
# Require an approver to sign off before anything is shared
SHARE_REQUIRES_APPROVAL=0
APPROVAL_TTL_MINUTES=60
# Let the requester approve their own request (off by default: separation of duties)
ALLOW_SELF_APPROVAL=0
# Shared secret for machine callers of POST /api/events/anomaly (Fabric Activator, Event Grid, Logic Apps), sent as X-Webhook-Secret
EVENT_WEBHOOK_SECRET=
# Where approved work orders are POSTed as JSON. Empty in mock mode = simulated work orders.
WORK_ORDER_WEBHOOK_URL=

# Written by `python -m agents.setup_agents`
FABRIC_AGENT_ID=
REPORT_BUILDER_AGENT_ID=
ORCHESTRATOR_AGENT_ID=
