# Azure AI Foundry project endpoint: https://<resource>.services.ai.azure.com/api/projects/<project>
PROJECT_ENDPOINT=
MODEL_DEPLOYMENT_NAME=gpt-4.1
# Full resource ID of the Microsoft Fabric connection in the Foundry project
FABRIC_CONNECTION_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<resource>/projects/<project>/connections/<fabric-connection>
MCP_SERVER_URL=https://learn.microsoft.com/api/mcp
MCP_SERVER_LABEL=microsoft_learn
ALLOWED_ORIGINS=http://localhost:3000
# Set to 1 to run the UI against scripted responses without Azure
MOCK_AGENTS=0

# Written by `python -m agents.setup_agents`
FABRIC_AGENT_ID=
DOCS_AGENT_ID=
REPORT_BUILDER_AGENT_ID=
ORCHESTRATOR_AGENT_ID=
